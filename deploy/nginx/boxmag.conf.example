# Exemplu nginx pentru Boxmag (VPS + docker compose --profile app)
#
# Domeniu canonical (SEO): https://boxmag.eu
#   - boxmag.ro, www.boxmag.ro, www.boxmag.eu -> 301 permanent catre boxmag.eu
#   - evita continut duplicat intre .eu si .ro
#
# Presupuneri Docker:
#   - Frontend: 127.0.0.1:3006
#   - Backend:  127.0.0.1:3005
#   - MinIO:    127.0.0.1:9000
#
# .env productie:
#   BACKEND_PUBLIC_URL=https://api.boxmag.eu
#   MINIO_PUBLIC_BASE_URL=https://storage.boxmag.eu
#   CORS_ORIGIN=https://boxmag.eu,https://www.boxmag.eu
#   FRONTEND_BASE_URL=https://boxmag.eu
#
# Instalare pe Ubuntu/Debian:
#   sudo cp deploy/nginx/boxmag.conf.example /etc/nginx/sites-available/boxmag.eu
#   sudo ln -sf /etc/nginx/sites-available/boxmag.eu /etc/nginx/sites-enabled/boxmag.eu
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx \
#     -d boxmag.eu -d www.boxmag.eu \
#     -d boxmag.ro -d www.boxmag.ro \
#     -d api.boxmag.eu -d storage.boxmag.eu

# --- HTTP ---

# .ro -> direct la canonical HTTPS (un singur salt)
server {
    listen 80;
    listen [::]:80;
    server_name boxmag.ro www.boxmag.ro;
    return 301 https://boxmag.eu$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name boxmag.eu www.boxmag.eu api.boxmag.eu storage.boxmag.eu;
    return 301 https://$host$request_uri;
}

# --- HTTPS: redirect domenii secundare -> canonical ---

# boxmag.ro + www -> boxmag.eu (pastreaza calea: /shop, /business, etc.)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name boxmag.ro www.boxmag.ro;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    return 301 https://boxmag.eu$request_uri;
}

# www.boxmag.eu -> boxmag.eu
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    return 301 https://boxmag.eu$request_uri;
}

# --- HTTPS: servicii principale ---

# Frontend (Next.js) — domeniu canonical
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Backend API (comenzi B2B, checkout, Stripe webhook, admin)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    # Necesar pentru atasamente PDF (base64 in JSON, pana la ~18 MB fisier)
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_request_buffering on;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# MinIO — bucket public (poze cutii din catalog)
# URL-uri in DB: https://storage.boxmag.eu/boxmag4-images/boxes/...
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name storage.boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
