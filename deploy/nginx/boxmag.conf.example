# Exemplu nginx pentru Boxmag (VPS + docker compose --profile app)
#
# Presupuneri:
#   - Frontend Docker: 127.0.0.1:3006
#   - Backend Docker:  127.0.0.1:3005
#   - MinIO API:       127.0.0.1:9000  (bucket public pentru poze cutii)
#   - .env producție:
#       BACKEND_PUBLIC_URL=https://api.boxmag.eu
#       MINIO_PUBLIC_BASE_URL=https://storage.boxmag.eu
#       CORS_ORIGIN=https://boxmag.eu,https://www.boxmag.eu
#       FRONTEND_BASE_URL=https://boxmag.eu
#
# Instalare pe Ubuntu/Debian:
#   sudo cp deploy/nginx/boxmag.conf.example /etc/nginx/sites-available/boxmag.eu
#   sudo ln -sf /etc/nginx/sites-available/boxmag.eu /etc/nginx/sites-enabled/boxmag.eu
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d boxmag.eu -d www.boxmag.eu -d api.boxmag.eu -d storage.boxmag.eu

# Redirect HTTP -> HTTPS (toate host-urile)
server {
    listen 80;
    listen [::]:80;
    server_name boxmag.eu www.boxmag.eu api.boxmag.eu storage.boxmag.eu;
    return 301 https://$host$request_uri;
}

# www -> apex
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    return 301 https://boxmag.eu$request_uri;
}

# Frontend (Next.js)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Backend API (comenzi B2B, checkout, Stripe webhook, admin)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    # Necesar pentru atasamente PDF (base64 in JSON, pana la ~18 MB fisier)
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stripe webhook: body-ul brut trebuie sa ajunga la backend
        proxy_request_buffering on;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# MinIO — bucket public (poze cutii din catalog)
# URL-urile din DB arata: https://storage.boxmag.eu/boxmag4-images/boxes/...
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name storage.boxmag.eu;

    ssl_certificate     /etc/letsencrypt/live/boxmag.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boxmag.eu/privkey.pem;

    client_max_body_size 25m;

    # Optional: blocheaza consola MinIO (9001) din internet
    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
