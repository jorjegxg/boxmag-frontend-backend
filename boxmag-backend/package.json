{
  "name": "boxmag-backend",
  "version": "1.0.0",
  "description": "Boxmag backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "bash ../scripts/reset-db.sh",
    "db:dev": "bash ./db/dev_seed_orders.sh",
    "db:seed:images": "node ./db/seed_minio_images.js"
  },
  "keywords": [],
  "author": "Boxmag",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "minio": "^8.0.7",
    "multer": "^2.1.1",
    "sharp": "^0.34.2",
    "mysql2": "^3.15.2",
    "nodemailer": "^8.0.7",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.7"
  }
}
