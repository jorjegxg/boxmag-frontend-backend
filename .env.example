PORT=3005
NODE_ENV=development
# development | production — controls dev form autofill (contact, checkout, etc.)
NEXT_PUBLIC_APP_ENV=development

# Admin panel password (frontend /admin — server-side only, not exposed to browser).
# The backend validates the same admin session cookie, so this gates the API too.
ADMIN_PASSWORD=change-me-admin-password
# Optional shared secret for server-to-server / scripted admin access to the API
# via `Authorization: Bearer <token>` or the `x-admin-token` header. Leave empty to disable.
ADMIN_API_TOKEN=
# HMAC secret for signed customer session cookies (falls back to ADMIN_PASSWORD if unset).
USER_SESSION_SECRET=
# Cookie domain for the admin session so it is shared between the frontend and the
# API subdomain in production (e.g. boxmag.eu makes it visible to api.boxmag.eu).
# Leave empty in local dev (localhost works across ports without a domain).
ADMIN_COOKIE_DOMAIN=
# Comma-separated allowed browser origins (apex + www in production)
CORS_ORIGIN=http://localhost:3006,https://boxmag.eu,https://www.boxmag.eu

# Backend DB connection
DB_HOST=localhost
DB_PORT=3307
DB_NAME=boxmag4
DB_USER=boxmag4
DB_PASSWORD=

# MySQL container/bootstrap values (used by docker-compose)
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=boxmag4
MYSQL_USER=boxmag4
MYSQL_PASSWORD=
TZ=UTC

# SMTP — Namecheap Private Email (smtp.privateemail.com)
# Primary mailbox (info): verification, contact form, newsletter, admin offers from info@
# IMAP (inbox only): imap.privateemail.com:993 — do NOT put IMAP host in SMTP_HOST
SMTP_HOST=smtp.privateemail.com
SMTP_PORT=465
SMTP_USER=info@boxmag.eu
SMTP_PASS=
EMAIL_FROM=info@boxmag.eu
CONTACT_TO=info@boxmag.eu
# Orders mailbox: order notifications, customer confirmations, admin offers from orders@
EMAIL_ORDERS_FROM=orders@boxmag.eu
EMAIL_ORDERS_SMTP_USER=orders@boxmag.eu
EMAIL_ORDERS_SMTP_PASS=
# Comma-separated. Prefer at least one non-orders mailbox (e.g. info@) —
# Private Email may accept but never show same-domain mail into orders@.
ORDERS_NOTIFICATION_TO=info@boxmag.eu,orders@boxmag.eu
# B2B mailbox: admin offers from b2b@
EMAIL_B2B_SMTP_USER=b2b@boxmag.eu
EMAIL_B2B_SMTP_PASS=
# Default offer sender in admin (orders | info | b2b)
EMAIL_OFFER_DEFAULT_FROM_KEY=orders
# Newsletter welcome email uses CONTACT_TO (fallback: EMAIL_FROM)

# Public site display emails (shown in UI, mailto links, legal text)
NEXT_PUBLIC_INFO_EMAIL=info@boxmag.eu
NEXT_PUBLIC_B2B_EMAIL=b2b@boxmag.eu
NEXT_PUBLIC_ORDERS_EMAIL=orders@boxmag.eu
# Dev-only form autofill (when NEXT_PUBLIC_APP_ENV=development or dev)
DEV_DEMO_CUSTOMER_EMAIL=customer.demo@boxmag.eu
DEV_AUTOFILL_EMAIL=

# Google Maps (checkout address map — enable Maps Embed API + Geocoding API)
# Use NEXT_PUBLIC_ so the key is available in the browser embed iframe.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Or only server-side (geocode route); embed still needs NEXT_PUBLIC_ or restart after setting GOOGLE_MAPS_API_KEY:
GOOGLE_MAPS_API_KEY=

TAX_PERCENT=21
NEXT_PUBLIC_TAX_PERCENT=21
BACKEND_PUBLIC_URL=http://localhost:3005

# Stripe checkout (default currency when checkout payload omits currency)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_SUCCESS_URL=http://localhost:3006/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3006/checkout/cancel

# MinIO (used by backend in Docker + seed_minio_images.js on the host)
# In .env for docker compose, backend uses MINIO_ENDPOINT=minio internally.
# seed_minio_images.js maps minio/mysql -> 127.0.0.1 when run via npm on the host.
MINIO_ENDPOINT=localhost
MINIO_PORT_API=9000
MINIO_ROOT_USER=boxmagadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_NAME=boxmag4-images
MINIO_PUBLIC_BASE_URL=http://localhost:9000
